pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        stage('Frontend Build') {
            steps{
                 dir('test-project/frontend'){
                    sh 'docker build -t shivamrajdocker/test-project-frontend:latest .'
              }
            }
        }
        stage('backend build') {
            steps{
                dir('test-project/backend'){
                    sh 'docker build -t shivamrajdocker/test-project-backend:latest .'
                }
            }
        }
        stage('Docker Hub Login'){
            steps{
                withCredentials([usernamePassword{
                    credentialsID : 'dockerhub'
                    usernameVariable: 'DOCKER_USERNAME'
                    passwordVariable: 'DOCKER_PASSWORD'
                }]){
                    sh '''
                    echo ""$DOCKER_PASSWORD" | docker login -u "$DOCKER_USERNAME" --password-stdin
                    '''
                }
            }
        }
    }
    post{
        success{
            echo 'Docker image built succesfully'
        }
        failure{
            echo 'failed'
        }
    }
}
